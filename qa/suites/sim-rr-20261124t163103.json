            "text": "Hello {{run_id}}-a"
          }
        }
      ]
    },
    {
      "name": "wave adds a line for our name",
      "tags": [
        "hello",
        "own-b"
      ],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open the hello page with our name",
          "url": "/hello.html?name={{run_id}}-b"
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "press Wave",
          "target": {
            "by": "role",
            "role": "button",
            "name": "Wave"
          }
